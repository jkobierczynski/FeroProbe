\f[V]\[rs]r\f[R], \f[V]\[rs]n\f[R], \f[V]\[rs]t\f[R], \f[V]\[rs]0\f[R],
\f[V]\[rs]\[rs]\f[R], \f[V]\[rs]\[dq]\f[R] and \f[V]\[rs]xHH\f[R] are
