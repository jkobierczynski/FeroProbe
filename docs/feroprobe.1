\f[V]-sT\f[R], \f[V]-sU\f[R], \f[V]-sV\f[R], \f[V]-b\f[R],
\f[V]-sn\f[R], \f[V]-Pn\f[R], \f[V]-PS\f[R] and \f[V]-PA\f[R] (as
