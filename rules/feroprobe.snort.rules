# FeroProbe scan detection rules — Snort 2.9.x
#
# For Snort 3 use rules/feroprobe.snort3.rules: the same rules in Snort 3
# syntax (content modifiers such as depth and distance written after a
# comma, not as separate options).
#
# Same signature as rules/feroprobe.rules (Suricata); see that file and
# docs/responsible-use.md for the full description. FeroProbe marks its own
# scan traffic so the owner of a scanned network can recognize it:
#   * Raw-socket TCP scan probes carry TCP window 65109 (0xFE55).
#   * UDP probes without a service-specific payload carry "FeroProbeScan/1".
#   * ICMP/ICMPv6 echo requests carry the 9-byte payload "feroprobe".
#   * Script HTTP requests (--script) carry a User-Agent naming
#     "FeroProbe Scripting Engine" (plain HTTP only; HTTPS hides it).
#
# The TCP connect scan (-sT) and OS-detection probes (-O) are the documented
# exceptions and carry no marker.
#
# SIDs use the local 9100000+ range. Adjust to fit your own numbering.

# SYN scan probe: lone SYN, no payload, marker window.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe SYN scan probe (window marker 0xFE55)"; flags:S; dsize:0; window:65109; classtype:attempted-recon; sid:9100001; rev:1;)

# Other raw-socket TCP scan probes: FIN, NULL, Xmas, ACK, Window, Maimon.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe stateless TCP scan probe (window marker 0xFE55)"; flags:!S; window:65109; classtype:attempted-recon; sid:9100002; rev:1;)

# UDP scan probe carrying FeroProbe's payload marker.
alert udp any any -> $HOME_NET any (msg:"FeroProbe UDP scan probe (payload marker)"; content:"FeroProbeScan/1"; depth:16; classtype:attempted-recon; sid:9100003; rev:1;)

# ICMP echo request (host discovery, -PO included) carrying FeroProbe's 9-byte payload.
alert icmp any any -> $HOME_NET any (msg:"FeroProbe ping probe (echo payload marker)"; itype:8; dsize:9; content:"feroprobe"; depth:9; classtype:attempted-recon; sid:9100004; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"FeroProbe IPv6 ping probe (echo payload marker)"; itype:128; dsize:9; content:"feroprobe"; depth:9; classtype:attempted-recon; sid:9100005; rev:1;)

# HTTP request from a FeroProbe script, by its User-Agent (plain HTTP only).
# Matched in the raw payload, not the HTTP buffers.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script HTTP request (User-Agent)"; flow:established,to_server; content:"User-Agent|3A| Mozilla/5.0 (compatible|3B| FeroProbe Scripting Engine"; nocase; classtype:attempted-recon; sid:9100006; rev:1;)

# Default scripts (-sC): the client names it sends in clear text.
# The SSH version line of ssh-hostkey and ssh2-enum-algos (sent before
# encryption starts).
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script SSH client (version string)"; flow:established,to_server; content:"SSH-2.0-FeroProbe_Scripting_Engine"; depth:34; classtype:attempted-recon; sid:9100007; rev:1;)
# smtp-commands' EHLO name (plain SMTP only; replaced by --script-args smtp.domain).
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script SMTP EHLO"; flow:established,to_server; content:"EHLO feroprobe.invalid"; depth:22; nocase; classtype:attempted-recon; sid:9100008; rev:1;)
# ftp-anon's anonymous password.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script FTP anonymous login"; flow:established,to_server; content:"PASS feroprobe@"; depth:15; classtype:attempted-recon; sid:9100009; rev:1;)
# smb2-security-mode / smb2-time: the client GUID of the SMB2 NEGOTIATE
# (TCP 445, or 139 after the NetBIOS session request).
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script SMB2 NEGOTIATE (client GUID)"; flow:established,to_server; content:"|FE|SMB"; offset:4; depth:4; content:"FeroProbeSMBScan"; distance:72; within:16; classtype:attempted-recon; sid:9100010; rev:1;)
# rdp-ntlm-info: the routing cookie of the RDP connection request (in clear
# text, before TLS starts).
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script RDP connection request (cookie)"; flow:established,to_server; content:"|03 00|"; depth:2; content:"Cookie|3A| mstshash=FeroProbe|0D 0A|"; distance:9; within:28; classtype:attempted-recon; sid:9100011; rev:1;)
# ssl-date: the mark in the ClientHello random (after the 5-byte record
# header, 4-byte handshake header, 2-byte version and 4 time bytes).
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script TLS ClientHello (ssl-date)"; flow:established,to_server; content:"|16 03 01|"; depth:3; content:"FeroProbeSSLDate"; distance:12; within:16; classtype:attempted-recon; sid:9100012; rev:1;)
# NetBIOS NODE STATUS request for "*" with transaction ID "FP": sent by the
# nbstat script and by the UDP scan (-sU) and -sV to port 137.
alert udp any any -> $HOME_NET 137 (msg:"FeroProbe NetBIOS NODE STATUS (nbstat script, -sU or -sV probe)"; content:"FP|00 00 00 01 00 00 00 00 00 00 20|CKAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|00 00 21 00 01|"; depth:50; classtype:attempted-recon; sid:9100013; rev:2;)
# DNS CHAOS TXT queries for id.server or version.bind with transaction ID
# "FP", only the RD flag (as in nmap's queries) and one question: sent by the
# dns-nsid script, over UDP and TCP (where a two-byte length comes first).
alert udp any any -> $HOME_NET any (msg:"FeroProbe DNS CHAOS TXT query (dns-nsid script)"; content:"FP|01 00 00 01 00 00 00 00 00|"; depth:11; pcre:"/^FP\x01\x00\x00\x01\x00{5}[\x00\x01](?:\x02id\x06server|\x07version\x04bind)\x00\x00\x10\x00\x03/s"; classtype:attempted-recon; sid:9100014; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"FeroProbe DNS CHAOS TXT query over TCP (dns-nsid script)"; flow:established,to_server; content:"FP|01 00 00 01 00 00 00 00 00|"; offset:2; depth:11; pcre:"/^.{2}FP\x01\x00\x00\x01\x00{5}[\x00\x01](?:\x02id\x06server|\x07version\x04bind)\x00\x00\x10\x00\x03/s"; classtype:attempted-recon; sid:9100015; rev:2;)
# *-ntlm-info scripts: the NTLM NEGOTIATE they send names the workstation
# FEROPROBE and is the same 49 bytes every time. Text protocols carry it in
# base64 (HTTP "Authorization: NTLM", SMTP/POP3 AUTH NTLM, IMAP AUTHENTICATE,
# NNTP AUTHINFO GENERIC; over STARTTLS it is encrypted); telnet and MS-SQL
# carry it as is.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script NTLM NEGOTIATE in base64 (*-ntlm-info)"; flow:established,to_server; content:"TlRMTVNTUAABAAAAB6IIogAAAAAAAAAACQAJACgAAAAAAAAAAAAAD0ZFUk9QUk9CRQ=="; classtype:attempted-recon; sid:9100016; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script NTLM NEGOTIATE (*-ntlm-info)"; flow:established,to_server; content:"NTLMSSP|00 01 00 00 00 07 A2 08 A2 00 00 00 00 00 00 00 00 09 00 09 00 28 00 00 00 00 00 00 00 00 00 00 0F|FEROPROBE"; classtype:attempted-recon; sid:9100017; rev:1;)
# smb-os-discovery / smb-security-mode / smb-protocols: the SMB1 NEGOTIATE
# offering only NT LM 0.12, with FeroProbe's process ID "FP" (TCP 445, or 139
# after the NetBIOS session request). smb-os-discovery's session setup
# carries the NTLM NEGOTIATE of SID 9100017 and the NativeOS and
# NativeLanMan "FeroProbe".
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script SMB1 NEGOTIATE (process ID FP)"; flow:established,to_server; content:"|FF|SMB|72|"; offset:4; depth:5; content:"|00 00 00 00 00 00 00 00 00 00 00 00 00 00|FP|00 00 01 00 00 0C 00 02|NT LM 0.12|00|"; distance:7; within:35; classtype:attempted-recon; sid:9100018; rev:1;)
# ssl-enum-ciphers / tls-alpn / tls-nextprotoneg (fero.tls): every TLS
# ClientHello (SSLv3 to TLS 1.3) carries "FeroProbeTLSScan" in its random,
# right after the four time bytes.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script TLS ClientHello (ssl-enum-ciphers, tls-alpn, tls-nextprotoneg)"; flow:established,to_server; content:"|16 03|"; depth:2; content:"FeroProbeTLSScan"; distance:13; within:16; classtype:attempted-recon; sid:9100019; rev:1;)
# sslv2: the SSLv2 CLIENT-HELLO (version 2) whose 16-byte challenge is
# "FeroProbeTLSScan".
alert tcp any any -> $HOME_NET any (msg:"FeroProbe script SSLv2 CLIENT-HELLO (sslv2)"; flow:established,to_server; content:"|01 00 02|"; offset:2; depth:3; content:"FeroProbeTLSScan"; distance:6; within:300; classtype:attempted-recon; sid:9100020; rev:1;)
# snmp-sysdescr / snmp-info / snmp-interfaces (fero.snmp): every SNMP PDU
# they send (v1/v2c GetRequest and GetNextRequest, and the SNMPv3 engine
# discovery's scoped PDU) has request-id 0x4650 ("FP") and no error, right
# before its variable list; the PDU tag (GetRequest or GetNextRequest) keeps
# the agent's answers out. The -sU/-sV probe to UDP 161 has request-id 1.
alert udp any any -> $HOME_NET any (msg:"FeroProbe script SNMP request (snmp-sysdescr, snmp-info, snmp-interfaces)"; content:"|30|"; depth:1; content:"|02 02 46 50 02 01 00 02 01 00 30|"; distance:0; pcre:"/[\xa0\xa1](?:[\x00-\x7f]|\x81[\x80-\xff]|\x82[\x01-\xff][\x00-\xff])\x02\x02\x46\x50\x02\x01\x00\x02\x01\x00\x30/s"; classtype:attempted-recon; sid:9100021; rev:1;)

# -sV msrpc probe: a DCE/RPC bind to the endpoint mapper interface whose
# call ID is "FPRO".
alert tcp any any -> $HOME_NET any (msg:"FeroProbe -sV DCE/RPC bind (call ID FPRO, msrpc probe)"; flow:established,to_server; content:"|05 00 0B 03 10 00 00 00 48 00 00 00|FPRO"; depth:16; content:"|08 83 AF E1 1F 5D C9 11 91 A4 08 00 2B 14 AC 40|"; distance:16; within:16; classtype:attempted-recon; sid:9100022; rev:1;)
# -sV kerberos probes: an AS-REQ for the client FeroProbe in the realm
# FEROPROBE.INVALID, over TCP (after a length prefix) and UDP.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe -sV Kerberos AS-REQ over TCP (realm FEROPROBE.INVALID)"; flow:established,to_server; content:"|6A 81 99 30 81 96 A1 03 02 01 05 A2 03 02 01 0A|"; offset:4; depth:16; content:"|1B 09|FeroProbe|A2 13 1B 11|FEROPROBE.INVALID"; distance:0; within:60; classtype:attempted-recon; sid:9100023; rev:1;)
alert udp any any -> $HOME_NET any (msg:"FeroProbe -sV Kerberos AS-REQ over UDP (realm FEROPROBE.INVALID)"; content:"|6A 81 99 30 81 96 A1 03 02 01 05 A2 03 02 01 0A|"; depth:16; content:"|1B 09|FeroProbe|A2 13 1B 11|FEROPROBE.INVALID"; distance:0; within:60; classtype:attempted-recon; sid:9100024; rev:1;)
# -sV netbios-ssn probe: a NetBIOS session request from the calling name
# FEROPROBE (first-level encoded).
alert tcp any any -> $HOME_NET any (msg:"FeroProbe -sV NetBIOS session request (calling name FEROPROBE)"; flow:established,to_server; content:"|81 00 00 44 20|"; depth:5; content:"|20|EGEFFCEPFAFCEPECEFCACACACACACAAA|00|"; distance:33; within:34; classtype:attempted-recon; sid:9100025; rev:1;)
# -sV mc-nmf probe: a .NET Message Framing preamble whose via is
# net.tcp://feroprobe.invalid/FeroProbe.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe -sV .NET Message Framing preamble (via feroprobe.invalid)"; flow:established,to_server; content:"|00 01 00 01 02 02 25|net.tcp|3A|//feroprobe.invalid/FeroProbe"; depth:44; classtype:attempted-recon; sid:9100026; rev:1;)

# -sV stun probe: a STUN Binding Request whose transaction ID is
# "FeroProbeSTN".
alert udp any any -> $HOME_NET any (msg:"FeroProbe -sV STUN Binding Request (transaction ID FeroProbeSTN)"; content:"|00 01 00 00 21 12 A4 42|FeroProbeSTN"; depth:20; classtype:attempted-recon; sid:9100027; rev:1;)
# -sV ike and ike-natt probes: an IKEv2 IKE_SA_INIT with initiator SPI
# "FeroProb" and nonce "FeroProbeIKEv2NonceFeroProbeIKE2" (on UDP 4500
# behind the four-byte non-ESP marker).
alert udp any any -> $HOME_NET any (msg:"FeroProbe -sV IKEv2 IKE_SA_INIT (SPI FeroProb)"; content:"FeroProb|00 00 00 00 00 00 00 00 21 20 22 08|"; depth:24; content:"FeroProbeIKEv2NonceFeroProbeIKE2"; distance:0; classtype:attempted-recon; sid:9100028; rev:1;)
# -sV l2tp probe: an L2TP SCCRQ from the host "feroprobe", vendor
# "FeroProbe".
alert udp any any -> $HOME_NET any (msg:"FeroProbe -sV L2TP SCCRQ (host feroprobe, vendor FeroProbe)"; content:"|C8 02|"; depth:2; content:"|00 07|feroprobe|00 0F 00 00 00 08|FeroProbe"; distance:0; classtype:attempted-recon; sid:9100029; rev:1;)
# -sV mdns probe: the DNS-SD service enumeration query with transaction ID
# 0x4650 ("FP"); a weak 2-byte mark, like rule 9100013.
alert udp any any -> $HOME_NET any (msg:"FeroProbe -sV DNS-SD query (transaction ID FP)"; content:"FP|00 00 00 01 00 00 00 00 00 00 09|_services|07|_dns-sd|04|_udp|05|local|00 00 0C 00 01|"; depth:46; classtype:attempted-recon; sid:9100030; rev:1;)
# -sV iax2 probe: an IAX2 POKE from source call number 0x4650 ("FP");
# a weak 2-byte mark.
alert udp any any -> $HOME_NET any (msg:"FeroProbe -sV IAX2 POKE (call number FP)"; content:"|C6 50 00 00 00 00 00 00 00 00 06 1E|"; depth:12; classtype:attempted-recon; sid:9100031; rev:1;)
# NSE dns module (dns.query, dns.update): queries and updates to port 53
# with transaction ID 0x4650 ("FP"), one question (or zone), no answers;
# a weak 2-byte mark, like rule 9100030. dns-nsid's queries (9100014,
# 9100015) match too.
alert udp any any -> $HOME_NET 53 (msg:"FeroProbe DNS query from an NSE script (transaction ID FP)"; content:"FP"; depth:2; pcre:"/^FP[\x00\x01\x28]\x00\x00\x01\x00\x00\x00[\x00\x01]/s"; classtype:attempted-recon; sid:9100032; rev:1;)
alert tcp any any -> $HOME_NET 53 (msg:"FeroProbe DNS query over TCP from an NSE script (transaction ID FP)"; flow:established,to_server; content:"FP"; offset:2; depth:2; pcre:"/^.{2}FP[\x00\x01\x28]\x00\x00\x01\x00\x00\x00[\x00\x01]/s"; classtype:attempted-recon; sid:9100033; rev:1;)
# NSE mysql module (mysql.loginRequest): the login names the client in its
# connection attributes, _client_name and program_name FeroProbe, when the
# server takes them (MySQL 5.6+, MariaDB 10+).
alert tcp any any -> $HOME_NET any (msg:"FeroProbe MySQL login from an NSE script (program_name FeroProbe)"; flow:established,to_server; content:"|0c|program_name|09|FeroProbe"; classtype:attempted-recon; sid:9100034; rev:1;)
alert udp any any -> $HOME_NET 137 (msg:"FeroProbe NetBIOS NAME QUERY from an NSE script (transaction ID FP)"; content:"FP"; depth:2; pcre:"/^FP\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x20[A-P]{32}\x00\x00\x20\x00\x01/s"; classtype:attempted-recon; sid:9100035; rev:1;)
# NSE rpc module: ONC RPC calls (portmapper, mountd, NFS and the calls of
# scripts such as rusers) whose XID FeroProbe chose: "FP" and 16 random
# bits, then CALL and RPC version 2. A script that passes its own XID
# (rpc-grind) is not matched; the -sV RPC probe (XID FPRO) is.
alert udp any any -> $HOME_NET any (msg:"FeroProbe ONC RPC call from an NSE script (XID FP)"; content:"FP"; depth:2; content:"|00 00 00 00 00 00 00 02|"; distance:2; within:8; classtype:attempted-recon; sid:9100036; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"FeroProbe ONC RPC call over TCP from an NSE script (XID FP)"; flow:established,to_server; content:"FP"; offset:4; depth:2; content:"|00 00 00 00 00 00 00 02|"; distance:2; within:8; classtype:attempted-recon; sid:9100037; rev:1;)

# LDAP (NSE ldap module): FeroProbe numbers its LDAP messages 0x4650nnnn
# ("FP" then a counter), right after the outer SEQUENCE and its length.
# Over UDP (CLDAP) only searches are sent, so the rule also wants the
# SearchRequest tag; a server's replies carry other tags.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe LDAP request from an NSE script (message ID FP)"; flow:established,to_server; content:"|30|"; depth:1; content:"|02 04 46 50|"; distance:1; within:7; classtype:attempted-recon; sid:9100038; rev:1;)
alert udp any any -> $HOME_NET any (msg:"FeroProbe CLDAP search from an NSE script (message ID FP)"; content:"|30|"; depth:1; content:"|02 04 46 50|"; distance:1; within:7; content:"|63|"; distance:2; within:1; classtype:attempted-recon; sid:9100039; rev:1;)

# MongoDB (NSE mongodb module): the OP_QUERY request ID's first two bytes
# on the wire are "FP"; responseTo is 0 and the opcode is 2004 (OP_QUERY).
alert tcp any any -> $HOME_NET any (msg:"FeroProbe MongoDB OP_QUERY from an NSE script (request ID FP)"; flow:established,to_server; content:"FP"; offset:4; depth:2; content:"|00 00 00 00 D4 07 00 00|"; distance:2; within:8; classtype:attempted-recon; sid:9100040; rev:1;)

# AJP13 (NSE ajp module): a FORWARD_REQUEST (magic 0x1234, type 2) whose
# coded User-Agent header (0xA00E) is FeroProbe's.
alert tcp any any -> $HOME_NET any (msg:"FeroProbe AJP13 request from an NSE script (User-Agent)"; flow:established,to_server; content:"|12 34|"; depth:2; content:"|02|"; offset:4; depth:1; content:"|A0 0E|"; distance:0; content:"FeroProbe Scripting Engine"; distance:2; within:60; classtype:attempted-recon; sid:9100041; rev:1;)

# AFP (NSE afp module): the first DSI request on a connection, a
# DSIGetStatus (3) or DSIOpenSession (4), carries request ID 0x4650 ("FP").
alert tcp any any -> $HOME_NET any (msg:"FeroProbe AFP DSI session from an NSE script (request ID FP)"; flow:established,to_server; content:"|46 50|"; offset:2; depth:2; pcre:"/^\x00[\x03\x04]\x46\x50/s"; classtype:attempted-recon; sid:9100042; rev:1;)
